<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@android:color/white">

    <!-- NestedScrollView to allow scrolling -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/buttonGoBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Judul Utama -->
            <TextView
                android:id="@+id/titleTextView"
                android:layout_width="match_parent"
                android:layout_height="87dp"
                android:paddingBottom="16dp"
                android:text="10 Rekomendasi Wisata Jogja"
                android:textColor="@android:color/black"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Wisata 1 (Candi Prambanan) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/prambananTitleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Candi Prambanan"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingTop="8dp"
                    android:textColor="@android:color/black" />

                <ImageView
                    android:id="@+id/prambananImageView"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/prmbn" />

                <TextView
                    android:id="@+id/prambananDescriptionTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Candi Prambanan adalah candi Hindu terbesar di Indonesia."
                    android:textSize="14sp"
                    android:paddingTop="4dp"
                    android:textColor="@android:color/black" />
            </LinearLayout>

            <!-- Wisata 2 (Pantai Parangtritis) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/parangtritisTitleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2. Pantai Parangtritis"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingTop="8dp"
                    android:textColor="@android:color/black" />

                <ImageView
                    android:id="@+id/parangtritisImageView"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/parangtritis" />

                <TextView
                    android:id="@+id/parangtritisDescriptionTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pantai Parangtritis terkenal dengan keindahan alamnya dan legenda yang melekat."
                    android:textSize="14sp"
                    android:paddingTop="4dp"
                    android:textColor="@android:color/black" />
            </LinearLayout>

            <!-- Wisata 3 (Malioboro) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/malioboroTitleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3. Malioboro"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingTop="8dp"
                    android:textColor="@android:color/black" />

                <ImageView
                    android:id="@+id/malioboroImageView"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/malio" />

                <TextView
                    android:id="@+id/malioboroDescriptionTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Malioboro adalah pusat perbelanjaan dan destinasi wisata favorit di Yogyakarta."
                    android:textSize="14sp"
                    android:paddingTop="4dp"
                    android:textColor="@android:color/black" />
            </LinearLayout>

            <!-- Wisata 4 (Keraton Yogyakarta) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/keratonTitleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4. Keraton Yogyakarta"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingTop="8dp"
                    android:textColor="@android:color/black" />

                <ImageView
                    android:id="@+id/keratonImageView"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/krtn" />

                <TextView
                    android:id="@+id/keratonDescriptionTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Keraton Yogyakarta adalah istana resmi Kesultanan Yogyakarta."
                    android:textSize="14sp"
                    android:paddingTop="4dp"
                    android:textColor="@android:color/black" />
            </LinearLayout>

            <!-- Wisata 5 (Taman Sari) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/tamansariTitleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="5. Taman Sari"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingTop="8dp"
                    android:textColor="@android:color/black" />

                <ImageView
                    android:id="@+id/tamansariImageView"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/tamansari" />

                <TextView
                    android:id="@+id/tamansariDescriptionTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Taman Sari adalah bekas taman kerajaan dari Keraton Yogyakarta."
                    android:textSize="14sp"
                    android:paddingTop="4dp"
                    android:textColor="@android:color/black" />
            </LinearLayout>

            <!-- Wisata 6 (Gunung Merapi) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/merapiTitleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="6. Gunung Merapi"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingTop="8dp"
                    android:textColor="@android:color/black" />

                <ImageView
                    android:id="@+id/merapiImageView"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/merapi" />

                <TextView
                    android:id="@+id/merapiDescriptionTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gunung Merapi adalah gunung berapi paling aktif di Indonesia."
                    android:textSize="14sp"
                    android:paddingTop="4dp"
                    android:textColor="@android:color/black" />
            </LinearLayout>

            <!-- Wisata 7 (Pantai Indrayanti) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/indrayantiTitleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="7. Pantai Indrayanti"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingTop="8dp"
                    android:textColor="@android:color/black" />

                <ImageView
                    android:id="@+id/indrayantiImageView"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/indrayanti" />

                <TextView
                    android:id="@+id/indrayantiDescriptionTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pantai Indrayanti adalah salah satu pantai pasir putih terbaik di Gunungkidul."
                    android:textSize="14sp"
                    android:paddingTop="4dp"
                    android:textColor="@android:color/black" />
            </LinearLayout>

            <!-- Wisata 8 (Goa Jomblang) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/jomblangTitleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="8. Goa Jomblang"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingTop="8dp"
                    android:textColor="@android:color/black" />

                <ImageView
                    android:id="@+id/jomblangImageView"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/jmblg" />

                <TextView
                    android:id="@+id/jomblangDescriptionTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Goa Jomblang adalah goa vertikal dengan hutan purba di dasar goa."
                    android:textSize="14sp"
                    android:paddingTop="4dp"
                    android:textColor="@android:color/black" />
            </LinearLayout>

            <!-- Wisata 9 (Kalibiru) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/kalibiruTitleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="9. Kalibiru"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingTop="8dp"
                    android:textColor="@android:color/black" />

                <ImageView
                    android:id="@+id/kalibiruImageView"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/kali" />

                <TextView
                    android:id="@+id/kalibiruDescriptionTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kalibiru adalah tempat wisata alam dengan pemandangan pegunungan dan danau."
                    android:textSize="14sp"
                    android:paddingTop="4dp"
                    android:textColor="@android:color/black" />
            </LinearLayout>

            <!-- Wisata 10 (Bukit Bintang) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/bukitbintangTitleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="10. Bukit Bintang"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingTop="8dp"
                    android:textColor="@android:color/black" />

                <ImageView
                    android:id="@+id/bukitbintangImageView"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bukit" />

                <TextView
                    android:id="@+id/bukitbintangDescriptionTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bukit Bintang adalah tempat terbaik untuk melihat pemandangan malam kota Yogyakarta."
                    android:textSize="14sp"
                    android:paddingTop="4dp"
                    android:textColor="@android:color/black" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Tombol Go Back di bagian bawah layar -->
    <Button
        android:id="@+id/buttonGoBack"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Go Back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
